	(text "SCK (Shared Clock) Serial Clock"
		(exclude_from_sim no)
		(at 73.406 77.724 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4fb5bcdb-6fa0-4f9a-801c-ff59dfacd69e")
	)
	(text "Serial Data (SD): Carries the actual audio bits (the music or sound wave data).\nBit Clock (BCLK / SCK): Tells the system when to read each individual bit of data.\nWord Select (WS / LRCK): Tells the system whether the current data belongs to the left audio channel or the right audio channel.\nMaster Clock (MCLK): An optional extra clock line used by high-precision gear to keep everything perfectly synchronized.\n L/R (Left/Right Channel Select) Determines which timing window the microphone owns on the data line."
		(exclude_from_sim no)
		(at 77.216 143.256 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5d55e937-7c0e-4bb2-b787-2cd6d64f2cf4")
	)
	(text "Serial-Data Output for I²S Interface(SD)\n\n"
